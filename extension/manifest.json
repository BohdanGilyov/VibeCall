
{
  "manifest_version": 3,
  "name": "Snom ChatGPT Bridge",
  "version": "1.2.0",
  "description": "Send Snom voice transcription to ChatGPT and signal when the answer is ready.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "http://127.0.0.1:47624/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
